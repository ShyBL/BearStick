.container {
    flex-grow: 1;
    padding-top: 8%;
    padding-right: 5%;
    padding-bottom: 5%;
    padding-left: 5%;
}

.element-background {
    background-image: url('project://database/Assets/_Underneath/UI/Sprites/Underneath_UI_BG_Rough.png?fileID=21300000&guid=a87ef6a5d9dd08746bd40277ff09071e&type=3#Underneath_UI_BG_Rough');
    -unity-background-scale-mode: scale-and-crop;
}

.tiled-background {
    background-image: url('project://database/Assets/_Underneath/UI/CaraTemp/ButtonBackgroundTile3.png?fileID=2800000&guid=f42a66ca093e7e24fbdab8c012e47ab0&type=3#ButtonBackgroundTile3');
    background-repeat: repeat;
    background-size: 768px 768px;
}

.button {
    transition-property: rotate, scale;
    transition-duration: 0.15s, 0.15s;
    font-size: 60px;
    -unity-font-style: bold;
    -unity-font: url('project://database/Assets/_Underneath/UI/eraser.dust.ttf?fileID=12800000&guid=b3dc55facd0a279468a8b82953b055a9&type=3#eraser.dust');
    text-shadow: 2px 5px 0.1px rgb(0, 0, 0);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    flex-wrap: wrap-reverse;
    color: rgb(0, 0, 0);
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    overflow: visible;
    -unity-font-definition: initial;
    opacity: 1;
}

.button:hover {
    scale: 1.15 1.15;
}

.text {
    -unity-font: url('project://database/Assets/_Underneath/UI/eraser.dust.ttf?fileID=12800000&guid=b3dc55facd0a279468a8b82953b055a9&type=3#eraser.dust');
    -unity-font-definition: initial;
    color: rgb(255, 255, 255);
    text-shadow: 0 2px -10.2px rgb(0, 0, 0);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.mainmenu-button {
    -unity-font-style: normal;
    width: 260px;
    height: 115px;
    -unity-font-definition: initial;
    -unity-font: url('project://database/Assets/_Underneath/UI/eraser.dust.ttf?fileID=12800000&guid=b3dc55facd0a279468a8b82953b055a9&type=3#eraser.dust');
    font-size: 60px;
    white-space: normal;
    margin-left: 15px;
    margin-right: 15px;
    color: rgb(255, 255, 255);
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    overflow: visible;
}

.button-border {
    flex-grow: 1;
    background-image: url('project://database/Assets/_Underneath/UI/Sprites/NEW/Button2.png?fileID=2800000&guid=d364e16d5d3011e4992b15436e6c8f5d&type=3#Button2');
    -unity-slice-left: 65;
    -unity-slice-top: 65;
    -unity-slice-right: 65;
    -unity-slice-bottom: 65;
    -unity-slice-scale: 0.2px;
    -unity-background-scale-mode: stretch-to-fill;
    margin-top: -4px;
    margin-right: -4px;
    margin-bottom: -4px;
    margin-left: -4px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}
