                <ui:VisualElement name="Wallet" class="pocket-item" style="background-image: url(&apos;project://database/Assets/_Underneath/Inventory/NewIcons/wallet_tooltip%20(1).png?fileID=21300000&amp;guid=6b736fd3a2122e142b29cecbf14b548e&amp;type=3#wallet_tooltip (1)&apos;); -unity-background-scale-mode: stretch-to-fill; width: 29%; height: 86%; bottom: 5%; -unity-background-image-tint-color: rgb(255, 255, 255);">
                    <ui:Label tabindex="-1" text="20" parse-escape-sequences="true" display-tooltip-when-elided="true" name="WalletCounter" class="element-background text" style="color: rgb(255, 255, 255); font-size: 50px; -unity-text-align: middle-center; padding-top: 0; padding-right: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-left: 0; padding-bottom: 0; margin-bottom: 108%; background-image: none; flex-grow: 1;" />
