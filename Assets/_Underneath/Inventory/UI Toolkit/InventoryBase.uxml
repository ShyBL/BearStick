            </ui:VisualElement>
            <ui:VisualElement name="Pockets" style="width: 100%; height: 33%; flex-direction: row; justify-content: space-between; padding-top: 5%;">
                <ui:VisualElement name="Empty1" class="pocket-item">
                    <ui:VisualElement name="EmptyPocket" class="pocket" />
                </ui:VisualElement>
                <ui:VisualElement name="Empty2" class="pocket-item">
