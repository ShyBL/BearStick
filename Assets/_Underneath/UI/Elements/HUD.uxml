<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Underneath/Inventory/UI%20Toolkit/BaseUIStyle.uss?fileID=7433441132597879392&amp;guid=302a0e2215d761242893af0356419587&amp;type=3#BaseUIStyle" />
    <Style src="project://database/Assets/_Underneath/UI/Style%20Sheets/HudStyle.uss?fileID=7433441132597879392&amp;guid=968a4811d903a914493117bf9f051f07&amp;type=3#HudStyle" />
    <ui:VisualElement name="Container" style="align-self: flex-start; margin-top: 20px; margin-left: 20px; position: absolute; transition-duration: 0.25s; transition-timing-function: ease-in-out; align-items: flex-start; flex-direction: row;">
        <ui:VisualElement name="BorderHorizontal" style="background-image: url(&apos;project://database/Assets/_Underneath/UI/Sprites/NEW/ButtonBag.png?fileID=2800000&amp;guid=3f4fe2674136ce04f90b4413b0a91980&amp;type=3#ButtonBag&apos;); -unity-background-scale-mode: stretch-to-fill; width: 266px; height: 108px; align-items: flex-end; justify-content: center; padding-top: 20px; padding-right: 15px; padding-bottom: 20px; padding-left: 135px;">
            <ui:VisualElement name="_ratio" style="flex-direction: row; flex-grow: 1; align-self: stretch; align-items: center; justify-content: flex-end;">
                <ui:Label tabindex="-1" text="5" parse-escape-sequences="true" display-tooltip-when-elided="true" name="CurrentWeight" class="title-text text" />
                <ui:Label tabindex="-1" text="/" parse-escape-sequences="true" display-tooltip-when-elided="true" name="_slash" class="title-text text" />
                <ui:Label tabindex="-1" text="10" parse-escape-sequences="true" display-tooltip-when-elided="true" name="MaxWeight" class="title-text text" />
            </ui:VisualElement>
            <ui:VisualElement name="Indicator" style="position: absolute; height: 35px; width: 35px; left: 9px; top: 10px; background-image: url(&apos;project://database/Assets/_Underneath/UI/CaraTemp/IndicatorIcon.png?fileID=2800000&amp;guid=3d925a4b2a4e42446b7c0651a4916b01&amp;type=3#IndicatorIcon&apos;);" />
            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="Inventory" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0);" />
        </ui:VisualElement>
        <ui:VisualElement name="Horizontal" style="align-items: center; flex-direction: row;">
            <ui:VisualElement name="Image" style="flex-grow: 1; width: 110px; height: 84px; background-image: url(&apos;project://database/Assets/_Underneath/UI/CaraTemp/Bag.png?fileID=2800000&amp;guid=2c41367de27b95244a3da02daade17d9&amp;type=3#Bag&apos;);" />
            <ui:VisualElement name="_ratio" style="flex-direction: row; flex-grow: 1; align-self: auto; align-items: center; justify-content: flex-end;">
                <ui:Label tabindex="-1" text="5" parse-escape-sequences="true" display-tooltip-when-elided="true" name="CurrentWeight" class="title-text text" />
                <ui:Label tabindex="-1" text="/" parse-escape-sequences="true" display-tooltip-when-elided="true" name="_slash" class="title-text text" />
                <ui:Label tabindex="-1" text="10" parse-escape-sequences="true" display-tooltip-when-elided="true" name="MaxWeight" class="title-text text" />
            </ui:VisualElement>
            <ui:VisualElement name="Indicator" style="position: absolute; height: 35px; width: 35px; left: 1px; top: 1px; background-image: url(&apos;project://database/Assets/_Underneath/UI/CaraTemp/IndicatorIcon.png?fileID=2800000&amp;guid=3d925a4b2a4e42446b7c0651a4916b01&amp;type=3#IndicatorIcon&apos;);" />
        </ui:VisualElement>
        <ui:VisualElement name="Vertical" style="align-items: center;">
            <ui:VisualElement name="Image" style="flex-grow: 1; width: 110px; height: 84px; background-image: url(&apos;project://database/Assets/_Underneath/UI/CaraTemp/Bag.png?fileID=2800000&amp;guid=2c41367de27b95244a3da02daade17d9&amp;type=3#Bag&apos;);" />
            <ui:VisualElement name="_ratio" style="flex-direction: row; flex-grow: 1; align-self: auto; align-items: center; justify-content: flex-end;">
                <ui:Label tabindex="-1" text="5" parse-escape-sequences="true" display-tooltip-when-elided="true" name="CurrentWeight" class="title-text text" />
                <ui:Label tabindex="-1" text="/" parse-escape-sequences="true" display-tooltip-when-elided="true" name="_slash" class="title-text text" />
                <ui:Label tabindex="-1" text="10" parse-escape-sequences="true" display-tooltip-when-elided="true" name="MaxWeight" class="title-text text" />
            </ui:VisualElement>
            <ui:VisualElement name="Indicator" style="position: absolute; height: 35px; width: 35px; left: 1px; top: 1px; background-image: url(&apos;project://database/Assets/_Underneath/UI/CaraTemp/IndicatorIcon.png?fileID=2800000&amp;guid=3d925a4b2a4e42446b7c0651a4916b01&amp;type=3#IndicatorIcon&apos;);" />
        </ui:VisualElement>
        <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="Settings" class="button" style="background-color: rgba(0, 0, 0, 0); background-image: url(&apos;project://database/Assets/_Underneath/UI/Sprites/NEW/Setting%20Icon.png?fileID=2800000&amp;guid=83e6983e2bc162b40a8a1ddfe362227a&amp;type=3#Setting Icon&apos;); margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; width: 75px; height: 65px;" />
        <CustomButton Show-Border="false" name="Settings_Custom" class="button" style="background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(255, 255, 255); width: 75px; height: 65px; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-image: url(&apos;project://database/Assets/_Underneath/UI/Sprites/NEW/Setting%20Icon.png?fileID=2800000&amp;guid=83e6983e2bc162b40a8a1ddfe362227a&amp;type=3#Setting Icon&apos;);" />
    </ui:VisualElement>
</ui:UXML>
