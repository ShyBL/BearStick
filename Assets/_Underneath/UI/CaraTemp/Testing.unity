      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 1474958111874514805, guid: 5f30ab33f0b56ab41b45278b801e0743, type: 3}
      propertyPath: m_DialogueLines.Array.data[0]
      value: "\u201CKeep your hands to yourself. Don\u2019t even THINK of trying
        anything. In fact, don\u2019t go walking around my shop, okay? Just stay
        right there.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 1474958111874514805, guid: 5f30ab33f0b56ab41b45278b801e0743, type: 3}
      propertyPath: m_DialogueLines.Array.data[1]
      value: "\u201CTell your friends about me. Always love working with the less-fortunate.\u201D "
      objectReference: {fileID: 0}
    - target: {fileID: 1474958111874514805, guid: 5f30ab33f0b56ab41b45278b801e0743, type: 3}
      propertyPath: m_DialogueLines.Array.data[2]
      value: "\u201CAre you going to buy something, or what?\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 1474958111874514805, guid: 5f30ab33f0b56ab41b45278b801e0743, type: 3}
      propertyPath: m_DialogueLines.Array.data[3]
      value: "\u201CI guess I could resell this. Fine, I\u2019ll take it.\u201D -
        \u201C...Why is it so sticky?\u201D "
      objectReference: {fileID: 0}
